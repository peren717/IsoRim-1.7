# IsoRim autodoor_frame (tools/make_autodoor.py); closed shells, 1 unit = 1 cell, +Y up, -Z north
mtllib isorim.mtl
o autodoor_frame
v -0.50000 1.20000 -0.16000
v 0.50000 1.20000 0.16000
v 0.50000 1.20000 -0.16000
v -0.50000 1.20000 0.16000
v -0.50000 1.06000 0.16000
v 0.50000 1.06000 -0.16000
v 0.50000 1.06000 0.16000
v -0.50000 1.06000 -0.16000
vt -0.5000 -0.1600
vt 0.5000 0.1600
vt 0.5000 -0.1600
vt -0.5000 0.1600
vt -0.5000 1.0600
vt 0.5000 1.2000
vt -0.5000 1.2000
vt 0.5000 1.0600
vt -0.1600 1.0600
vt 0.1600 1.2000
vt -0.1600 1.2000
vt 0.1600 1.0600
usemtl stuff
f 1/1 2/2 3/3
f 1/1 4/4 2/2
usemtl stuff_dark
f 5/4 6/3 7/2
f 5/4 8/1 6/3
f 5/5 2/6 4/7
f 5/5 7/8 2/6
f 6/8 1/7 3/6
f 6/8 8/5 1/7
f 8/9 4/10 1/11
f 8/9 5/12 4/10
f 7/12 3/11 2/10
f 7/12 6/9 3/11
