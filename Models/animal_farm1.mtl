# IsoRim farm animals in the blob style (Chicken, Cow + Bull, Pig). Generated by tools/make_farm1_concept.py.
# Kd = the vanilla sprite's lit white; the colour comes from the game (ModelDef tintFromGraphic, Api 49):
# hen white, rooster/cockerel (200,150,85), chick (223,219,108), cow (200,200,200), bull (170,170,170), sow (211,190,174), boar (167,145,128).
newmtl an_chicken_blob
Kd 0.960 0.960 0.960
map_Kd IsoRim/Animals/Chicken

newmtl an_cow_blob
Kd 0.960 0.960 0.960
map_Kd IsoRim/Animals/Cow

newmtl an_bull_blob
Kd 0.960 0.960 0.960
map_Kd IsoRim/Animals/Bull

newmtl an_pig_blob
Kd 0.960 0.960 0.960
map_Kd IsoRim/Animals/Pig
