# IsoRim techist_door_frame (tools/make_stylefurn.py); closed shells, 1 unit = 1 cell, +Y up, -Z north
mtllib isorim.mtl
mtllib stylefurn.mtl
o techist_door_frame
v -0.50000 1.20000 0.16000
v 0.50000 1.20000 -0.16000
v -0.50000 1.20000 -0.16000
v 0.50000 1.20000 0.16000
v -0.50000 1.06000 0.16000
v 0.50000 1.06000 0.16000
v 0.50000 1.06000 -0.16000
v -0.50000 1.06000 -0.16000
vt -0.5000 0.1600
vt 0.5000 -0.1600
vt -0.5000 -0.1600
vt 0.5000 0.1600
vt -0.5000 1.0600
vt 0.5000 1.2000
vt -0.5000 1.2000
vt 0.5000 1.0600
vt -0.1600 1.0600
vt 0.1600 1.2000
vt -0.1600 1.2000
vt 0.1600 1.0600
usemtl stuff
f 1/1 2/2 3/3
f 1/1 4/4 2/2
usemtl stuff_dark
f 5/5 4/6 1/7
f 5/5 6/8 4/6
f 7/8 3/7 2/6
f 7/8 8/5 3/7
f 8/9 1/10 3/11
f 8/9 5/12 1/10
f 6/12 2/11 4/10
f 6/12 7/9 2/11
