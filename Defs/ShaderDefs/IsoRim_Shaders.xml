<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    IsoRim 3D view shaders. All use Shaders\IsoRimSolid.frag.glsl (vertex colour * _Color [* texture])
    and vanilla SceneDefault.vert.glsl, or Shaders\IsoRim.vert.glsl (the same plus wall end lines, moving
    outlines and instancing) or Shaders\IsoRimTex.vert.glsl (the same plus instancing only) where noted;
    only the render state differs. Depth is reverse-Z (compare GreaterOrEqual), front face clockwise. Materials may override renderQueue. The card and fog-lid defs
    at the end use copies of the game's own fragment stages with IsoRim's vertex stages.
  -->

  <!-- Opaque vertex-coloured geometry: wall/rock lines and lids, model faces, pawns, animals, doors,
       turbines, tools, roofs (queue 3600 on the material). Cull off: meshes are not closed. -->
  <ShaderDef>
    <defName>IsoRimSolid</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRim.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <blendMode>Opaque</blendMode>
      <cullMode>None</cullMode>
      <renderQueue>2000</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- Opaque textured faces (cut out below alpha 0.5): textured wall/rock sides and tops, model and
       dynamic textured faces, strata, damage marks, roof slates (3601). Queue 2001 so they draw after
       the plain copies they lie on (same depth passes GreaterOrEqual). -->
  <ShaderDef>
    <defName>IsoRimSolidTex</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimTex.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <blendMode>Opaque</blendMode>
      <cullMode>None</cullMode>
      <renderQueue>2001</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- Inside-out hull shells drawn behind models: only back faces show. Pushed away from the camera
       (negative = away under reverse-Z) so the shell never shows through the model's own faces.
       Moving models' shells are also pushed back in the vertex stage where they face the camera. -->
  <ShaderDef>
    <defName>IsoRimOutline</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRim.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <blendMode>Opaque</blendMode>
      <cullMode>Front</cullMode>
      <depthBiasConstantFactor>-1</depthBiasConstantFactor>
      <depthBiasSlopeFactor>-1</depthBiasSlopeFactor>
      <renderQueue>2000</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- Blueprints and frames: see-through, but they write depth so a ghost hides its own back faces.
       Queue 3101: after the game's lighting overlay; they take the light of their own cell. -->
  <ShaderDef>
    <defName>IsoRimGhost</defName>
    <shaderProgram>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <blendMode>Alpha</blendMode>
      <depthWrite>true</depthWrite>
      <cullMode>Back</cullMode>
      <renderQueue>3101</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- See-through, depth-tested, no depth write: stylised water (3050), ground AO shadows (2420),
       plain fallback shadows (2900). -->
  <ShaderDef>
    <defName>IsoRimBlend</defName>
    <shaderProgram>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <blendMode>Alpha</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3050</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- Night and indoor light on 3D faces (the light pass). Faces lit from IsoRim's own glow texture
       (_GlowMode 1) are drawn a second time with these, depth-tested against themselves and writing
       no depth: the colour already there (the face, and anything see-through drawn over it since,
       such as smoke) is multiplied by the light of the face's own cell, as the game's overlay does
       (DstColor/SrcColor), and stencil bit 32 is set, once per pixel. Sprites drawn in front of a
       face hide it from this pass and keep the game's overlay, which skips bit 32. The game never
       uses bit 32. Queue 3099: after everything that writes depth, just before the overlay. -->
  <ShaderDef>
    <defName>IsoRimLitMark</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRim.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>DstColor</blendSrcFactor>
      <blendDstFactor>SrcColor</blendDstFactor>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <stencilEnabled>true</stencilEnabled>
      <stencilCompare>NotEqual</stencilCompare>
      <stencilPassOp>Replace</stencilPassOp>
      <stencilRef>32</stencilRef>
      <stencilReadMask>32</stencilReadMask>
      <stencilWriteMask>32</stencilWriteMask>
      <renderQueue>3099</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- The same for textured faces, so cut-out holes (alpha below 0.5) are left to the overlay. -->
  <ShaderDef>
    <defName>IsoRimLitMarkTex</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimTex.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>DstColor</blendSrcFactor>
      <blendDstFactor>SrcColor</blendDstFactor>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <stencilEnabled>true</stencilEnabled>
      <stencilCompare>NotEqual</stencilCompare>
      <stencilPassOp>Replace</stencilPassOp>
      <stencilRef>32</stencilRef>
      <stencilReadMask>32</stencilReadMask>
      <stencilWriteMask>32</stencilWriteMask>
      <renderQueue>3099</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- The same for the plant cards (UprightCards): their own vertex stage, so the pass covers exactly the stood-up,
       swaying card; cut out like the card. -->
  <ShaderDef>
    <defName>IsoRimLitMarkCard</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimCard.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimCardMark.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>DstColor</blendSrcFactor>
      <blendDstFactor>SrcColor</blendDstFactor>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <stencilEnabled>true</stencilEnabled>
      <stencilCompare>NotEqual</stencilCompare>
      <stencilPassOp>Replace</stencilPassOp>
      <stencilRef>32</stencilRef>
      <stencilReadMask>32</stencilReadMask>
      <stencilWriteMask>32</stencilWriteMask>
      <renderQueue>3099</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- The game's lighting overlay (its own LightOverlay.frag.glsl and render state), pulled toward
       the camera by IsoRim, but skipping the pixels marked above: those faces carry their own light. -->
  <ShaderDef>
    <defName>IsoRimLightOverlay</defName>
    <shaderProgram>
      <fragmentShaderFileName>LightOverlay.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>DstColor</blendSrcFactor>
      <blendDstFactor>SrcColor</blendDstFactor>
      <depthWrite>false</depthWrite>
      <stencilEnabled>true</stencilEnabled>
      <stencilCompare>NotEqual</stencilCompare>
      <stencilPassOp>Keep</stencilPassOp>
      <stencilRef>32</stencilRef>
      <stencilReadMask>32</stencilReadMask>
      <stencilWriteMask>0</stencilWriteMask>
      <renderQueue>3100</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- (Api 33) Beams (Beams.cs): light, not things. Unlit (_LightMode 0), added to what is behind (SrcAlpha One: only
       brightens), no depth write, no culling. Queue 3151, as the game's own glowing motes: after the night and indoor
       light overlay (3100), so a beam is as bright at night; before the fog-of-war lid (3175). Beam parts of models
       (beam_* materials) and line motes drawn as beams (MoteBeam). The same vertex stage as the solids (roof clipping). -->
  <ShaderDef>
    <defName>IsoRimAdd</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRim.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3151</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- See-through marks drawn over everything (drag box, brackets): no depth test or write. -->
  <ShaderDef>
    <defName>IsoRimOverlay</defName>
    <shaderProgram>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <blendMode>Alpha</blendMode>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3650</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- Ghosts of things to be built inside a wall or other solid building (a door replacing a wall section, a fixture
       whose sprite lies in the wall): seen through it, as the mining x-ray. No depth test or write, front faces only. -->
  <ShaderDef>
    <defName>IsoRimGhostXray</defName>
    <shaderProgram>
      <fragmentShaderFileName>IsoRimSolid.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <blendMode>Alpha</blendMode>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>Back</cullMode>
      <renderQueue>3651</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- The colour grade: one full-screen pass after everything else in the map view. The engine copies
       the picture drawn so far into _GrabIsoRimGrade; the pass looks each pixel up in a LUT strip.
       The game's interface is drawn later, outside the map view, and is not graded. -->
  <ShaderDef>
    <defName>IsoRimGrade</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimScreen.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimGrade.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <blendMode>Opaque</blendMode>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>4900</renderQueue>
      <sceneGrab>
        <name>IsoRimGrade</name>
        <queue>4900</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>

  <!-- Plants without a 3D model, stood up as cards facing the camera (IsoRimCard.vert.glsl turns
       them from the camera's angle, so a tilt or a turn rebuilds nothing). Render state and fragment
       stage as the game's CutoutPlant (plants) and TransparentPlant (their snow), whose materials
       these replace for cards. -->
  <ShaderDef>
    <defName>IsoRimCardPlant</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimCard.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimCardPlant.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>true</depthWrite>
      <renderQueue>2900</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>IsoRimCardSnow</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimCard.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimCardSnow.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <renderQueue>2900</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- The fog of unexplored areas as a lid on the tops of the rock and walls under it: the game's
       FogOfWar state and fragment stage; IsoRimFog.vert.glsl lifts each corner from the map's cell
       texture (IsoCellMap). -->
  <ShaderDef>
    <defName>IsoRimFog</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimFog.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimFog.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <renderQueue>3175</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_DetailTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!-- Zoomed-out silhouettes in 3D (Silhouettes3D): the game's own silhouette fragment shader, drawn over everything
       (no depth test) after the light overlay, so trees, mountains, walls, roofs and the fog lid never hide them. -->
  <ShaderDef>
    <defName>IsoRimSilhouette</defName>
    <shaderProgram>
      <fragmentShaderFileName>Silhouette.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3640</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- Water ripples and flow streaks: the game's own Transparent shader with the texture repeating
       instead of clamped (the game's Transparent def clamps it). Their texture slides on without end
       (the material's texture offset), so with a clamped texture they were invisible. -->
  <ShaderDef>
    <defName>IsoRimWave</defName>
    <shaderProgram>
      <vertexShaderFileName>Transparent.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>Transparent.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <renderQueue>3053</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!-- Depth only, for the perspective camera (Sky.cs): the map's ground as a flat quad, so the distance fog
       and the sky see the game's terrain (which writes no depth) at its real distance. Queue 3180: after
       everything that writes depth, before the fog. -->
  <ShaderDef>
    <defName>IsoRimDepthPlane</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimDepthPlane.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimDepthPlane.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <blendMode>Opaque</blendMode>
      <colorWrite>false</colorWrite>
      <depthWrite>true</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3180</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- Distance fog for the perspective camera (Sky.cs): layers of full-screen quads at set distances,
       depth-tested, blended. Queue 3190: after the lighting overlay and the fog-of-war lid. -->
  <ShaderDef>
    <defName>IsoRimDistFog</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimDistFog.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimDistFog.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <blendMode>Alpha</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3190</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- The sky for the perspective camera (Sky.cs): a full-screen quad at the far depth, so only
       pixels nothing was drawn on take it. Queue 3195: after the distance fog, which would cover it. -->
  <ShaderDef>
    <defName>IsoRimSky</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimSky.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimSky.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <blendMode>Opaque</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3195</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- The painted sky (IsoRimSettings.skyStyle 0, the default): the same quad and inputs as IsoRimSky. -->
  <ShaderDef>
    <defName>IsoRimSkyPaint</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimSky.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimSkyPaint.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <blendMode>Opaque</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3195</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- Space maps with the planet below (Sky.PlanetBelow): the same program darkens the game's planet
       backdrop below the horizon by the map's sky light, with the game's light-overlay blend (2 x src x dst). -->
  <ShaderDef>
    <defName>IsoRimSkyDim</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimSky.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimSky.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>DstColor</blendSrcFactor>
      <blendDstFactor>SrcColor</blendDstFactor>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3196</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- Tilt-shift (TiltShift.cs): two grabbed full-screen passes (separable blur), before FXAA. -->
  <ShaderDef>
    <defName>IsoRimTiltH</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimScreen.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimTiltH.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <blendMode>Opaque</blendMode>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>4880</renderQueue>
      <sceneGrab>
        <name>TiltA</name>
        <queue>4880</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>IsoRimTiltV</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimScreen.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimTiltV.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <blendMode>Opaque</blendMode>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>4881</renderQueue>
      <sceneGrab>
        <name>TiltB</name>
        <queue>4881</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>

  <!-- Anti-aliasing (AntiAlias.cs): FXAA as one full-screen pass over the map view drawn so far
       (scene grab IsoRimAA), just before the colour grade. The interface is drawn later and untouched. -->
  <ShaderDef>
    <defName>IsoRimAA</defName>
    <shaderProgram>
      <vertexShaderFileName>IsoRimScreen.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimAA.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <blendMode>Opaque</blendMode>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>4890</renderQueue>
      <sceneGrab>
        <name>IsoRimAA</name>
        <queue>4890</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>

  <!-- Faded floors (FadeFloors, prototype): the game's Cutout, CutoutComplex and terrain shaders with the FadeFloors
       drop (_IsoFade) in copies of their fragment stages; render state exactly as the game's defs. Materials of a floor
       drawn faded are swapped for copies on these. -->
  <ShaderDef>
    <defName>IsoRimFadeCutout</defName>
    <shaderProgram>
      <fragmentShaderFileName>IsoRimFadeCutout.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>true</depthWrite>
      <renderQueue>2900</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>IsoRimFadeCutoutComplex</defName>
    <shaderProgram>
      <fragmentShaderFileName>IsoRimFadeCutoutComplex.frag.glsl</fragmentShaderFileName>
      <transparent>true</transparent>
      <depthWrite>true</depthWrite>
      <renderQueue>2900</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>IsoRimFadeTerrainHard</defName>
    <shaderProgram>
      <vertexShaderFileName>MapWorldUV.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimFadeTerrainHard.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <depthWrite>false</depthWrite>
      <renderQueue>2000</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>IsoRimFadeTerrainFade</defName>
    <shaderProgram>
      <vertexShaderFileName>MapWorldUV.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimFadeTerrainFade.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <renderQueue>2001</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>IsoRimFadeTerrainFadeRough</defName>
    <shaderProgram>
      <vertexShaderFileName>MapWorldUV.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>IsoRimFadeTerrainFadeRough.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <renderQueue>2001</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_AlphaAddTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

</Defs>
