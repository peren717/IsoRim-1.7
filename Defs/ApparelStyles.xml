<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The Ideology styles of the marine, recon and cataphract helmets (Api 56). Style-only bindings: plain helmets keep the hat kind IsoRim gives them. -->
  <IsoRim.ApparelModelDef>
    <defName>R3DApparel_Styles_Marine</defName>
    <apparel>Apparel_PowerArmorHelmet</apparel>
    <slot>Head</slot>
    <byStyle>
      <li>
        <style>Animalist_MarineHelmet</style>
        <model>Models/person_hat_marine_helm_animalist.obj</model>
        <shows><li>Face</li></shows>
      </li>
      <li>
        <style>Morbid_MarineHelmet</style>
        <model>Models/person_hat_marine_helm_morbid.obj</model>
        <shows><li>Face</li></shows>
      </li>
      <li>
        <style>Totemic_MarineHelmet</style>
        <model>Models/person_hat_marine_helm_totemic.obj</model>
        <shows><li>Face</li></shows>
      </li>
    </byStyle>
  </IsoRim.ApparelModelDef>
  <IsoRim.ApparelModelDef>
    <defName>R3DApparel_Styles_Recon</defName>
    <apparel>Apparel_ArmorHelmetRecon</apparel>
    <slot>Head</slot>
    <byStyle>
      <li>
        <style>Animalist_ReconHelmet</style>
        <model>Models/person_hat_recon_helm_animalist.obj</model>
        <shows><li>Face</li></shows>
      </li>
      <li>
        <style>Morbid_ReconHelmet</style>
        <model>Models/person_hat_recon_helm_morbid.obj</model>
        <shows><li>Face</li></shows>
      </li>
      <li>
        <style>Totemic_ReconHelmet</style>
        <model>Models/person_hat_recon_helm_totemic.obj</model>
        <shows><li>Face</li></shows>
      </li>
    </byStyle>
  </IsoRim.ApparelModelDef>
  <IsoRim.ApparelModelDef>
    <defName>R3DApparel_Styles_Cataphract</defName>
    <apparel>Apparel_ArmorHelmetCataphract</apparel>
    <slot>Head</slot>
    <byStyle>
      <li>
        <style>Animalist_CataphractHelmet</style>
        <model>Models/person_hat_cataphract_helm_animalist.obj</model>
      </li>
      <li>
        <style>Morbid_CataphractHelmet</style>
        <model>Models/person_hat_cataphract_helm_morbid.obj</model>
      </li>
      <li>
        <style>Totemic_CataphractHelmet</style>
        <model>Models/person_hat_cataphract_helm_totemic.obj</model>
      </li>
    </byStyle>
  </IsoRim.ApparelModelDef>
</Defs>
